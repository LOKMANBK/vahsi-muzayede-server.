# =========================================================
#  Vahşi Müzayede — Ortam Değişkenleri
#  Tüm zorunlu ve opsiyonel değişkenler burada açıklanmıştır.
#  Production'da bu değerleri Railway / Render dashboard'ından girin.
# =========================================================

# ── Zorunlu ──────────────────────────────────────────────

# Upstash Redis → Dashboard → Connect → Node.js → ioredis URL'si
# Tek instance kullanıyorsanız bu değişkeni kaldırabilirsiniz (in-memory stub devreye girer)
# Birden fazla Railway replika kullanıyorsanız ZORUNLUdur.
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

# Supabase proje URL'si (stats yazma, profil güncelleme)
SUPABASE_URL=https://PROJE_ID.supabase.co

# Supabase service_role key — RLS'i bypass eder, ASLA client'a verme
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ── Sunucu ───────────────────────────────────────────────

# Railway/Render otomatik doldurur
PORT=8080

# 'production' | 'development'
NODE_ENV=production

# debug | info | warn | error
LOG_LEVEL=info

# /stats endpoint'ini korumak için Bearer token (boş bırakılırsa endpoint açık olur)
STATS_TOKEN=gizli_bir_token_buraya

# ── Crash Reporting — Sentry ─────────────────────────────

# Sentry → Projects → Settings → Client Keys → DSN
# Boş bırakılırsa Sentry devre dışı kalır (geliştirme ortamı için uygundur)
SENTRY_DSN=https://KEY@XXXXXX.ingest.sentry.io/PROJE_ID

# Hangi ortamda olduğunu Sentry'de ayırt etmek için
# Genellikle 'production' | 'staging'
SENTRY_ENVIRONMENT=production

# Her hata veya işlemin örnekleme oranı (0.0 – 1.0)
# Production'da 0.1–0.2 önerilir; geliştirmede 1.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Analytics — PostHog ───────────────────────────────────

# PostHog → Project Settings → API Keys → Project API Key
# Boş bırakılırsa analytics devre dışı kalır
POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# PostHog host — kendi instance'ınız varsa değiştirin
POSTHOG_HOST=https://eu.posthog.com

# ── Bot Eşleştirme ────────────────────────────────────────

# Bir public odada ikinci oyuncu bu süre (ms) içinde gelmezse bot eklenir
# 0 veya boş bırakılırsa bot sistemi devre dışı kalır
BOT_MATCH_DELAY_MS=30000
